# ==============================================================================
# SPOOKTACULAR HALLOWEEN PARTY 2026 - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and provide your specific credentials.
# IMPORTANT: Never commit actual secret keys or .env files to GitHub.
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=production

# Supabase PostgreSQL Configuration (Required for Vercel Serverless Deployment)
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Trusted server-side secret key (bypasses RLS for secure backend operations; NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin Authentication & Security
# Used to sign stateless JWT cookies across Vercel Lambda containers
ADMIN_JWT_SECRET=generate-a-strong-random-32-character-secret
SESSION_SECRET=generate-a-strong-session-secret

# Initial Admin Credentials (used during database bootstrap)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-very-strong-admin-password
ADMIN_EMAIL=admin@spooktacular2026.com

# CORS Configuration
# Set to your Vercel production domain, e.g., https://your-project.vercel.app
CORS_ORIGIN=https://your-project.vercel.app

# Optional Local SQLite Storage (Used automatically when SUPABASE_URL is omitted)
DATABASE_PATH=./data/spooktacular.db

# Optional Test Clock Override (Asia/Kolkata ISO format; leave commented in production)
# TEST_CLOCK_OVERRIDE=2026-10-24T12:00:00+05:30
